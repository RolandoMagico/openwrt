Assisted-by: Claude:claude-opus-5
Signed-off-by: Grische <github@grische.xyz>

diff --git a/arch/Kconfig b/arch/Kconfig
index ee9fd0150f48..f05d789716fa 100644
--- a/arch/Kconfig
+++ b/arch/Kconfig
@@ -356,6 +356,15 @@ config ARCH_HAS_SET_DIRECT_MAP
 config ARCH_HAS_DMA_SET_UNCACHED
 	bool
 
+#
+# Select if arch_dma_set_uncached can only alias part of memory, and the
+# architecture has sized ZONE_DMA to describe that part. dma-direct then
+# takes coherent allocations from ZONE_DMA, because anywhere else has no
+# uncached alias to hand back.
+#
+config ARCH_DMA_SET_UNCACHED_ZONE_DMA_ONLY
+	bool
+
 #
 # Select if the architectures provides the arch_dma_clear_uncached symbol
 # to undo an in-place page table remap for uncached access.
diff --git a/arch/mips/Kconfig b/arch/mips/Kconfig
index eddfc62918d9..edf3c1401292 100644
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -478,6 +478,7 @@ config LANTIQ
 
 config INTEL_MIPS
 	bool "Intel MIPS interAptiv SoC based platforms"
+	select ARCH_DMA_SET_UNCACHED_ZONE_DMA_ONLY
 	select BOOT_RAW
 	select CEVT_R4K
 	select COMMON_CLK
diff --git a/arch/mips/mm/dma-noncoherent.c b/arch/mips/mm/dma-noncoherent.c
index e89b07a1e160..1d9a05e43b85 100644
--- a/arch/mips/mm/dma-noncoherent.c
+++ b/arch/mips/mm/dma-noncoherent.c
@@ -54,6 +54,13 @@ void arch_dma_prep_coherent(struct page *page, size_t size)
  * Upper bound on the physical addresses an uncached alias may be taken of.
  * Above it the uncached window maps registers rather than DRAM, so a coherent
  * allocation placed there would be handed a register address.
+ *
+ * Coherent allocations are confined to this window before they are made --
+ * ZONE_DMA describes it and ARCH_DMA_SET_UNCACHED_ZONE_DMA_ONLY makes
+ * dma-direct allocate from there -- so an address arriving here that is
+ * above the line means something got past that, which is a bug rather than
+ * a condition. The check stays, and stays loud, because the alternative to
+ * catching it here is not catching it at all.
  */
 #define INTEL_MIPS_UNCAC_DRAM_LIMIT	(PHYS_OFFSET + SZ_256M)
 
diff --git a/kernel/dma/direct.c b/kernel/dma/direct.c
index cc334eb94b33..93f5d83aad67 100644
--- a/kernel/dma/direct.c
+++ b/kernel/dma/direct.c
@@ -239,6 +239,18 @@ void *dma_direct_alloc(struct device *dev, size_t size,
 			pr_warn_once("coherent DMA allocations not supported on this platform.\n");
 			return NULL;
 		}
+
+		/*
+		 * Where only part of memory can be aliased uncached, that part
+		 * is ZONE_DMA and the allocation has to come out of it: pages
+		 * from anywhere else have no alias to return. Ask for the zone
+		 * now rather than allocate first and discover it in
+		 * arch_dma_set_uncached(), which can only fail the allocation
+		 * by then.
+		 */
+		if (IS_ENABLED(CONFIG_ARCH_DMA_SET_UNCACHED_ZONE_DMA_ONLY) &&
+		    set_uncached)
+			gfp |= GFP_DMA;
 	}
 
 	/*
