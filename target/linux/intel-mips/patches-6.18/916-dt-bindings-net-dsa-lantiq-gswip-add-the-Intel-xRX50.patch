@@ -200,3 +303,57 @@ examples:
                     };
             };
     };
+
+  - |
+    switch@1c000000 {
+            compatible = "lantiq,xrx500-gswip";
+            reg = <0x1c000000 0x4000>;
+            dsa,member = <0 0>;
+            dma-noncoherent;
+
+            ports {
+                    #address-cells = <1>;
+                    #size-cells = <0>;
+
+                    port@0 {
+                            reg = <0>;
+                            phy-mode = "internal";
+                            ethernet = <&conduit>;
+
+                            fixed-link {
+                                    speed = <1000>;
+                                    full-duplex;
+                            };
+                    };
+
+                    port@5 {
+                            reg = <5>;
+                            label = "lan1";
+                            phy-mode = "internal";
+                            phy-handle = <&gphy5>;
+                    };
+            };
+
+            mdio {
+                    #address-cells = <1>;
+                    #size-cells = <0>;
+
+                    gphy5: ethernet-phy@5 {
+                            reg = <5>;
+                    };
+            };
+
+            gphy-fw {
+                    #address-cells = <1>;
+                    #size-cells = <0>;
+                    compatible = "lantiq,xrx500-gphy-fw";
+                    firmware-name = "lantiq/xrx500-phy-fw.bin";
+
+                    gphy@f96 {
+                            reg = <0xf96>;
+
+                            resets = <&rcu_reset0 25 25>;
+                            reset-names = "gphy";
+                    };
+            };
+    };
