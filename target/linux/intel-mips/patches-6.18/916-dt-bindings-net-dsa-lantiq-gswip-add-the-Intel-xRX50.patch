@@ -70,9 +84,9 @@ properties:
         properties:
           reg:
             minimum: 0
-            maximum: 255
             description:
-              Offset of the GPHY firmware register in the RCU register range
+              Offset of this PHY's firmware address register in the window
+              the loader's compatible names.
 
           resets:
             items:
@@ -87,7 +101,6 @@ properties:
 
     required:
       - compatible
-      - lantiq,rcu
 
     additionalProperties: false
 
@@ -95,6 +108,96 @@ required:
   - compatible
   - reg
 
+allOf:
+  - $ref: dsa.yaml#/$defs/ethernet-ports
+
+  # The GSWIP-2.x models: three regions, an MDIO bus that is a device of its
+  # own, and the firmware address registers of the integrated PHYs in the
+  # reset control unit.
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - lantiq,xrx200-gswip
+              - lantiq,xrx300-gswip
+              - lantiq,xrx330-gswip
+    then:
+      properties:
+        reg:
+          minItems: 3
+
+        mdio:
+          required:
+            - compatible
+
+        gphy-fw:
+          patternProperties:
+            "^gphy@[0-9a-f]{1,3}$":
+              properties:
+                reg:
+                  maximum: 255
+
+          required:
+            - lantiq,rcu
+
+  # GSWIP-3.0: one region covering the switch core, the macro's top block and
+  # the packet MAC. The MDIO bus and the firmware loader reach their registers
+  # through that region, so neither is a device of its own and neither takes a
+  # region or a syscon of its own.
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - lantiq,xrx500-gswip
+              - lantiq,xrx500-gswip-r
+    then:
+      properties:
+        reg:
+          maxItems: 1
+
+        reg-names: false
+
+        mdio:
+          properties:
+            compatible: false
+
+        gphy-fw:
+          properties:
+            lantiq,rcu: false
+
+          patternProperties:
+            "^gphy@[0-9a-f]{1,3}$":
+              properties:
+                reg:
+                  maximum: 4095
+
+          required:
+            - firmware-name
+
+      required:
+        - dma-noncoherent
+
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              enum:
+                - lantiq,xrx200-gswip
+                - lantiq,xrx300-gswip
+                - lantiq,xrx330-gswip
+                - lantiq,xrx500-gswip
+                - lantiq,xrx500-gswip-r
+    then:
+      properties:
+        reg:
+          maxItems: 1
+
+        reg-names: false
+        gphy-fw: false
+
 unevaluatedProperties: false
 
