--- a/Documentation/devicetree/bindings/net/dsa/lantiq,gswip.yaml
+++ b/Documentation/devicetree/bindings/net/dsa/lantiq,gswip.yaml
@@ -6,8 +6,13 @@ $schema: http://devicetree.org/meta-schemas/core.yaml#
 
 title: Lantiq GSWIP Ethernet switches
 
-allOf:
-  - $ref: dsa.yaml#/$defs/ethernet-ports
+description:
+  The GSWIP switch macro is embedded in Lantiq and Intel SoCs. The GSWIP-2.x
+  models place the MDIO master and the MII port configuration in register
+  regions of their own, next to the switch core. GSWIP-3.0 keeps the same
+  switch core at the same offsets and moves those functions, along with the
+  packet MAC that faces the SoC's queue manager, into the switch's own
+  register window, so one region describes the whole macro.
 
 maintainers:
   - Hauke Mehrtens <hauke@hauke-m.de>
@@ -18,9 +23,11 @@ properties:
       - lantiq,xrx200-gswip
       - lantiq,xrx300-gswip
       - lantiq,xrx330-gswip
+      - lantiq,xrx500-gswip
+      - lantiq,xrx500-gswip-r
 
   reg:
-    minItems: 3
+    minItems: 1
     maxItems: 3
 
   reg-names:
@@ -29,6 +36,8 @@ properties:
       - const: mdio
       - const: mii
 
+  dma-noncoherent: true
+
   mdio:
     $ref: /schemas/net/mdio.yaml#
     unevaluatedProperties: false
@@ -37,9 +46,6 @@ properties:
       compatible:
         const: lantiq,xrx200-mdio
 
-    required:
-      - compatible
-
   gphy-fw:
     type: object
     properties:
@@ -50,19 +56,27 @@ properties:
         const: 0
 
       compatible:
-        items:
-          - enum:
-              - lantiq,xrx200-gphy-fw
-              - lantiq,xrx300-gphy-fw
-              - lantiq,xrx330-gphy-fw
-          - const: lantiq,gphy-fw
+        oneOf:
+          - items:
+              - enum:
+                  - lantiq,xrx200-gphy-fw
+                  - lantiq,xrx300-gphy-fw
+                  - lantiq,xrx330-gphy-fw
+              - const: lantiq,gphy-fw
+          - const: lantiq,xrx500-gphy-fw
 
       lantiq,rcu:
         $ref: /schemas/types.yaml#/definitions/phandle
         description: phandle to the RCU syscon
 
+      firmware-name:
+        maxItems: 1
+        description:
+          Image the integrated PHYs run, where the loader takes the name from
