+static int xrx500_cbm_set_rx_report(const char *val,
+				    const struct kernel_param *kp)
+{
+	struct xrx500_cbm_rx *rx;
+	struct xrx500_cbm *priv;
+	unsigned int armed = 0;
+	unsigned int done = 0;
+	unsigned int i;
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+
+	guard(mutex)(&xrx500_cbm_lock);
+	priv = xrx500_cbm_singleton;
+	if (!priv)
+		return 0;
+
+	rx = &priv->rx;
+	if (!rx->ring) {
+		pr_info("%s: receive ring not built (own_rx=%u)\n",
+			XRX500_CBM_DRV_NAME, own_rx);
+		return 0;
+	}
+
+	for (i = 0; i < rx->ring_len; i++) {
+		u32 ctl = READ_ONCE(rx->ring[i].ctl);
+
+		if (ctl & CBM_RXD_CTL_OWN)
+			armed++;
+		else if (ctl & CBM_RXD_CTL_C)
+			done++;
+	}
+
+	pr_info("%s: ring=%u buf=%u boff=%u next=%u armed=%u completed=%u%s\n",
+		XRX500_CBM_DRV_NAME, rx->ring_len, rx->buf_len, rx->boff,
+		rx->next, armed, done, rx->aborted ? " ABORTED" : "");
+	pr_info("%s: polls=%llu completions=%llu bytes=%llu delivered=%llu wraps=%llu\n",
+		XRX500_CBM_DRV_NAME, rx->stats.polls, rx->stats.completions,
+		rx->stats.bytes, rx->stats.delivered, rx->stats.wraps);
+	pr_info("%s: malformed=%llu drop_noskb=%llu\n",
+		XRX500_CBM_DRV_NAME, rx->stats.malformed,
+		rx->stats.drop_noskb);
+
+	for (i = 0; i < PMAC_RX_SPPID_NUM; i++)
+		if (rx->sppid[i])
+			pr_info("%s: source port %u: %llu frames\n",
+				XRX500_CBM_DRV_NAME, i, rx->sppid[i]);
+
+	return 0;
+}
