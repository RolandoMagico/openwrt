From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Mon, 17 Aug 2026 19:24:47 +0200
Subject: MIPS: dts: intel-mips: add the AVM FRITZ!Box 7590 (HW226, GRX550)

Second board of this platform and the first on the GRX550 die. It reuses
xrx500.dtsi unchanged: the two dies share their MMIO map, both GSWIP
instances and the whole clock tree, and the CPU-rate difference between
them is one CGU mux bit the clock driver reads out of silicon.

What this file describes is the console, memory, the persistent store and
flash. Three of those are not the FRITZ!Box 7560's values:

  - Memory is 224 MiB of the board's 512, ending exactly at
    0x2e000000. The ceiling is set by the 4Kec bootcore, which runs
    concurrently on every dual-kernel boot out of the 32 MiB window
    immediately above, and by that bootcore's fabric programming: it
    reads a ram-size of 256 MiB out of its own DT and denies every
    address above 0x30000000. Both regions get no-map reservations, so
    nothing this kernel does can reach the second CPU's DRAM even by
    accident. cpunet is inside the memory node and shows up as a split
    in the early memory ranges; the bootcore window sits outside it and
    its reservation is a documented no-op, kept because it is the reason
    the memory node stops where it does.

  - ramoops goes at 0x20100000, the address the vendor uses
    (grx_common.dtsi in the vendor device tree). Note the vendor node is
    *named* ramoops@20500000 while its reg says 0x20100000 -- and
    0x20500000 is this platform's load address, so a node built from the
    name would put the crash log on top of the kernel.

  - The flash map is the FRITZ!Box 7560's with the two kernel slots
    mirrored and a 491 MiB ubi partition. The boot-loader environment
    defines both kernel slots and its linux_fs_start selects between
    them; a fixed-partitions map necessarily pins one, so this pins
    slot 1 and the install procedure has to assert that before the
    first write.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Grische <github@grische.xyz>

diff --git a/arch/mips/boot/dts/intel-mips/seale_avm_fritz7590.dts b/arch/mips/boot/dts/intel-mips/seale_avm_fritz7590.dts
new file mode 100644
index 000000000000..297d1145371a
--- /dev/null
+++ b/arch/mips/boot/dts/intel-mips/seale_avm_fritz7590.dts
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 Grische <github@grische.xyz>
+/*
+ * AVM FRITZ!Box 7590 (HW226), GRX550. Board-specific data only; the SoC is
+ * described in xrx500.dtsi, the board family in seale_avm.dtsi and the die
+ * variant in seale_avm_grx550.dtsi.
+ */
+/dts-v1/;
+
+#include <dt-bindings/interrupt-controller/mips-gic.h>
+#include <dt-bindings/clock/intel,grx500-clk.h>
+
+#include "xrx500.dtsi"
+
+/ {
+	model = "AVM FRITZ!Box 7590";
+	compatible = "avm,fritz7590", "intel,xrx500";
+
+	/*
+	 * The boot loader carries a table of device-tree blobs keyed by
+	 * hardware sub-revision. Declaring the tag is cosmetic here — the
+	 * loader passes this kernel no device tree and the appended blob is
+	 * parsed unconditionally — but it stops the loader reporting an
+	 * unmatched sub-revision.
+	 */
+	avm-hw-revision {
+		compatible = "avm,avm_hw_revision";
+		revision = "226";
+		subrevision = "4";
+	};
+
+	/*
+	 * 224 MiB of the board's 512 MiB, at PHYS_OFFSET 0x20000000.
+	 *
+	 * The ceiling is not a guess and it is not the part's size. Two
+	 * separate things sit above it:
+	 *
+	 * The 4Kec bootcore. It runs concurrently with this kernel on every
+	 * dual-kernel boot, out of the 32 MiB window at 0x2e000000, with its
+	 * cpunet mailbox pool immediately below. Ending the memory node
+	 * exactly at 0x2e000000 keeps Linux and the bootcore out of each
+	 * other's DRAM by construction. Protecting: [0x30000000, 0x9fffffff]"
+	 * on this silicon. Anything this kernel places above 0x30000000 would
+	 * be denied by the fabric, not merely shared.
+	 *
+	 * Widening past this needs the bootcore question settled first (a
+	 * bootcore built for 512 MiB, or a single-kernel image that starts no
+	 * bootcore at all) and the KSEG1 aperture bound respected -- see the
+	 * warning on the reservations below.
+	 */
+	memory@20000000 {
+		device_type = "memory";
+		reg = <0x20000000 0x0e000000>;
+	};
+
+	aliases {
+		serial0 = &asc0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		/*
+		 * Unused while MIPS_CMDLINE_BUILTIN_EXTEND is selected;
+		 * present so a board that needs its own arguments has
+		 * somewhere to put them.
+		 */
+		bootargs = "";
+	};
+
+	/*
+	 * WARNING: every region here is below PHYS_OFFSET + 0x12310000
+	 * (0x32310000), and that is a requirement, not a coincidence. KSEG1 is one
+	 * 512 MiB window shared between the uncached DRAM alias and the SoC
+	 * register aperture, whose lowest block sits 0x12310000 past the RAM
+	 * base. A page above that bound has an uncached alias that *is* a
+	 * register address, so anything reached through ioremap(),
+	 * memremap(..., MEMREMAP_WC) or CKSEG1ADDR() has to live below it.
+	 *
+	 * The vendor's third reservation, an shm RNG seed at 0x3dfb0000, is
+	 * above the bound. It is out of range of the memory node today; if the
+	 * node is ever widened far enough to include it, a plain cached
+	 * mapping is fine and an uncached one is not.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Crash persistence, at the address the vendor's own device
+		 * tree uses for it (its node is named ramoops@20500000 while
+		 * its reg says 0x20100000). 1 MiB of the 4 MiB region below
+		 * _text. The zone sizes fill reg exactly; fs/pstore/ram.c
+		 * fails the whole probe if they overflow it.
+		 */
+		ramoops@20100000 {
+			compatible = "ramoops";
+			reg = <0x20100000 0x100000>;
+			record-size = <0x4000>;
+			console-size = <0x80000>;
+			mem-type = <1>;
+		};
+
+		/*
+		 * Owned by the second CPU's boot loader (the vendor ships its
+		 * own device tree for that core); no-map so this kernel never
+		 * maps another CPU's memory.
+		 */
+		cpunet@2dfc0000 {
+			reg = <0x2dfc0000 0x40000>;
+			no-map;
+		};
+
+		bootcore@2e000000 {
+			reg = <0x2e000000 0x2000000>;
+			no-map;
+		};
+	};
+};
+
+/*
+ * NAND. The controller and its wiring are identical to the FRITZ!Box 7560's -- EBU
+ * chip-select 1, on-die ECC -- and the chip self-identifies, so no geometry
+ * appears here. What differs is the chip: 512 MiB with a 4 KiB page and a
+ * 256 KiB erase block, against the FRITZ!Box 7560's 128 MiB / 2 KiB / 128 KiB. That
+ * matters to whoever builds the UBI image, not to this file.
+ */
+&ebu_nand {
+	status = "okay";
+
+	lantiq,cs = <1>;
+
+	nand@0 {
+		reg = <0>;
+		label = "nand0";
+
+		/*
+		 * Toshiba BENAND, ECC on the chip. Selected through the legacy
+		 * "nand-ecc-mode" property on purpose: the modern
+		 * "nand-ecc-engine" spelling is a phandle, and a string there
+		 * fails phandle resolution silently.
+		 */
+		nand-ecc-mode = "on-die";
+
+		/*
+		 * The two kernel slots are *mirrored* relative to the FRITZ!Box 7560,
+		 * because this unit has linux_fs_start = 1: the active slot
+		 * is the one at 0xd00000.
+		 *
+		 * So this map pins slot 1.
+		 */
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/*
+			 * First-stage boot loader, and the only copy of the
+			 * Wi-Fi calibration data. Read-only: overwriting it
+			 * bricks the device past the point of recovery
+			 * without an external programmer.
+			 */
+			partition@0 {
+				label = "urlader";
+				reg = <0x0 0x100000>;
+				read-only;
+			};
+
+			/*
+			 * AVM TFFS environment: the only copy of this unit's
+			 * identity (MAC addresses, serial number). Never
+			 * written from Linux, and erasing it cannot be undone.
+			 */
+			partition@100000 {
+				label = "nand-tffs";
+				reg = <0x100000 0x400000>;
+				read-only;
+			};
+
+			/* Inactive kernel slot 0. Written by sysupgrade. */
+			partition@500000 {
+				label = "reserved-kernel";
+				reg = <0x500000 0x800000>;
+			};
+
+			/*
+			 * Active kernel slot 1 -- the one EVA boots on this
+			 * unit.
+			 */
+			partition@d00000 {
+				label = "kernel";
+				reg = <0xd00000 0x800000>;
+			};
+
+			/* UBI: rootfs and rootfs_data. Ends at the 512 MiB mark. */
+			partition@1500000 {
+				label = "ubi";
+				reg = <0x1500000 0x1eb00000>;
+			};
+		};
+	};
+};
