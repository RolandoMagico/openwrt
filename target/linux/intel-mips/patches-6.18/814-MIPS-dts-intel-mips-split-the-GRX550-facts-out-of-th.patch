index 000000000000..49b238903c02
--- /dev/null
+++ b/arch/mips/boot/dts/intel-mips/seale_avm_grx550.dtsi
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 Grische <github@grische.xyz>
+/*
+ * AVM FRITZ!Box boards on the GRX550 die. Die-variant layer between
+ * seale_avm.dtsi and the board files: the fifth GPHY and its WAN port, the
+ * second MDIO bus, the front-panel LED controller and both USB host
+ * controllers.
+ */
+
+#include <dt-bindings/clock/intel,grx500-clk.h>
+#include <dt-bindings/gpio/gpio.h>
+
+#include "seale_avm.dtsi"
+
+/ {
+	/*
+	 * One enable line feeds both USB PHYs. Both take it as their
+	 * vbus-supply, which is legal and refcounted:
+	 * regulator_get_optional() is not an exclusive get, so a second
+	 * consumer is not turned away.
+	 */
+	usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio1 2 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/*
+	 * The blink generator's slow clock source: a fixed 8 kHz input the
+	 * driver divides for its blink table.
+	 */
+	sso_fpid: clock-8000 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <8000>;
+	};
+
+	/*
+	 * The front-panel LED controller. Four constraints:
+	 *
+	 * - "syscon" must stay in the compatible or syscon_node_to_regmap()
+	 *   fails.
+	 * - The clock-names order matters: clock 0 gates register access.
+	 * - The compatible selects the falling shift-clock edge. The vendor
+	 *   driver
+	 * defaults this SoC to the falling edge and treats rising as an
+	 * opt-in
+	 * device-tree property that no board sets; mainline's lgm-sso
+	 * hardcodes
+	 * rising instead.
+	 * - ngpios narrows the controller to the populated pins.
+	 */
+	ssogpio: ssogpio@16d00000 {
+		compatible = "intel,grx500-ssoled", "syscon";
+		reg = <0x16d00000 0x2cc>;
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		ngpios = <8>;
+
+		clocks = <&cgu GCLK_SSO>, <&sso_fpid>;
+		clock-names = "sso", "fpid";
+
+		intel,sso-update-rate-hz = <250000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_ledc>;
+	};
+};
+
+&usb0_phy {
+	status = "okay";
+	vbus-supply = <&usb_vbus>;
+};
+
+&usb0 {
+	status = "okay";
+};
+
+&usb1_phy {
+	status = "okay";
+	vbus-supply = <&usb_vbus>;
+};
+
+&usb1 {
+	status = "okay";
+};
+
+/*
+ * The three pads the shift register hangs off. Both spellings are required:
+ * the pinctrl driver rejects a child that has "groups" without "pins" or
+ * "pinmux", and it fails the whole pinctrl probe when it does.
+ */
+&pinctrl {
+	pinctrl_ledc: led-pins {
+		pins = <4>, <5>, <6>;
+		function = "led";
+		pinmux = <1>, <1>, <1>;
+		groups = "led";
+	};
+};
