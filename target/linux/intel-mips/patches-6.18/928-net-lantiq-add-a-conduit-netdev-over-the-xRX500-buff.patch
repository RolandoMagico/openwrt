diff --git a/drivers/net/ethernet/lantiq/Kconfig b/drivers/net/ethernet/lantiq/Kconfig
index 0071cfad7b55..3555745233a7 100644
--- a/drivers/net/ethernet/lantiq/Kconfig
+++ b/drivers/net/ethernet/lantiq/Kconfig
@@ -40,4 +40,19 @@ config INTEL_XRX500_BM
 
 	  Say N unless you are bringing this datapath up.
 
+config INTEL_XRX500_CBM_CONDUIT
+	bool "xRX500 buffer-manager conduit network device"
+	depends on INTEL_XRX500_BM
+	default n
+	help
+	  Conduit network device for the xRX500 central buffer manager: one
+	  netdev per switch macro whose transmit path enqueues into the
+	  buffer manager and whose receive path terminates that macro's own
+	  receive DMA ring.
+
+	  This is what a DSA switch driver for the macros binds as its
+	  conduit; without it the switch has no processor port.
+
+	  Say N unless you are bringing this datapath up.
+
 endif # INTEL_XRX500_NET
diff --git a/drivers/net/ethernet/lantiq/Makefile b/drivers/net/ethernet/lantiq/Makefile
index f0313921e9df..2fd1f944aeb9 100644
--- a/drivers/net/ethernet/lantiq/Makefile
+++ b/drivers/net/ethernet/lantiq/Makefile
@@ -14,3 +14,9 @@ intel-xrx500-bm-y += cqm/grx500/cbm_intr.o cqm/grx500/fsqm.o cqm/grx500/cbm_dma.
 intel-xrx500-bm-y += cqm/grx500/cbm_ports.o
 intel-xrx500-bm-y += dma/hdma.o
 intel-xrx500-bm-y += tmu/tmu_init.o tmu/drv_tmu_ll.o
+
+#
+# The buffer-manager conduit netdev. Built in, never a module: its transmit
+# path calls MIPS cache maintenance which is not exported to modules.
+#
+obj-$(CONFIG_INTEL_XRX500_CBM_CONDUIT) += xrx500-cbm.o
diff --git a/drivers/net/ethernet/lantiq/xrx500-cbm.c b/drivers/net/ethernet/lantiq/xrx500-cbm.c
