From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Tue, 1 Sep 2026 17:17:32 +0200
Subject: dt-bindings: pci: add Intel xRX500 PCIe root complex

The three root complexes of this SoC family have never been documented.
The driver they use is shared with intel,lgm-pcie, but the two nodes have
almost no required properties in common: this one has no core reset line,
its glue decodes the configuration window itself instead of leaving it to
generic ECAM, its byte swapping is in a syscon outside the controller, and
it has no MSI receiver. So it gets its own schema rather than a pile of
per-compatible conditionals bolted onto intel-gw-pcie.yaml, whose select:
is written for that compatible alone.

The compatible is a single string with no snps,dw-pcie fallback, which is
what snps,dw-pcie.yaml asks of new bindings in as many words. That is also
why the DesignWare properties come in through pci-host-bridge.yaml plus
snps,dw-pcie-common.yaml rather than through snps,dw-pcie.yaml: the latter
requires a node without msi-map to name an interrupt "msi", and this
family has none to name.

Three constraints are worth writing down as schema rather than prose.
bus-range must end at 7, because the configuration accessor decodes the
8 MiB window with three bits of bus number and bus 8 aliases onto the DBI
registers. max-link-speed cannot exceed 2, the PHY being PCIe 2.0.
reset-gpios is required, because the driver requests it unconditionally
before it will bring a port up.

intel,inbound-swap and intel,outbound-swap are documented as the explicit
0 or 1 the board files spell, not as flags. Whether they should have been
flags is a fair question, but it is a question about board device trees
that already exist rather than about the hardware, and answering it here
would be a change of form dressed up as documentation.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Grische <github@grische.xyz>

diff --git a/Documentation/devicetree/bindings/pci/intel,xrx500-pcie.yaml b/Documentation/devicetree/bindings/pci/intel,xrx500-pcie.yaml
new file mode 100644
index 000000000000..a78ea3a0ec3f
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/intel,xrx500-pcie.yaml
@@ -0,0 +1,193 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/intel,xrx500-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Intel xRX500 PCIe root complex
+
+maintainers:
+  - Grische <github@grische.xyz>
+
+description: |
+  One of the three Synopsys DesignWare PCIe 2.0 root complexes of the Intel
+  MIPS xRX500 (GRX500) SoC family. The three instances are identical apart
+  from their register windows, their interrupts, their gate clock, the serdes
+  PHY they drive and the pair of bits they own in the chip-top byte-swap word.
+
+  The controller is driven through the same driver as intel,lgm-pcie but is
+  described separately: it has no core reset line of its own, its glue decodes
+  the configuration window itself instead of leaving it to generic ECAM, and
+  its byte swapping lives outside the controller. The generic snps,dw-pcie
+  compatible is deliberately not carried as a fallback, as the DesignWare
+  schema asks of new bindings.
+
+  There is no MSI receiver wired up on this family, so legacy interrupts are
+  the only ones endpoints can raise and they reach the CPU through
+  interrupt-map.
+
+allOf:
+  - $ref: /schemas/pci/pci-host-bridge.yaml#
+  - $ref: /schemas/pci/snps,dw-pcie-common.yaml#
+
+properties:
+  compatible:
+    const: intel,xrx500-pcie
+
+  reg:
+    items:
+      - description: DesignWare core registers, reached over the DBI interface
+      - description: configuration space of the devices behind the port
+      - description: application logic wrapped around the core
+
+  reg-names:
+    items:
+      - const: dbi
+      - const: config
+      - const: app
+
+  interrupts:
+    maxItems: 1
+    description:
+      Aggregate interrupt of the application logic. It reports the controller's
+      own events, not the endpoints' legacy interrupts, which have their own
+      parent interrupts through interrupt-map.
+
+  interrupt-names:
+    items:
+      - const: ir
+
+  clocks:
+    maxItems: 1
+    description: The controller's gate clock.
+
+  phys:
+    maxItems: 1
+
+  phy-names:
+    const: pcie
+
+  bus-range:
+    description:
+      Must end at 7. The configuration accessor of this family decodes the
+      8 MiB window with three bits of bus number, so bus 8 aliases onto the
+      DBI registers.
+    items:
+      - const: 0
+      - const: 7
+
+  max-link-speed:
+    maximum: 2
+
+  reset-assert-ms:
+    description:
+      How long PERST# is held asserted, in milliseconds.
+    maximum: 500
+    default: 100
+
+  intel,syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle to the chip-top syscon
+          - description: >
+              byte offset within it of the word that holds the byte-swap
+              enables of every root complex
+    description:
+      Byte swapping is done outside the controller, in one word of the chip-top
+      syscon that all three root complexes share. Which two bits of that word
+      belong to this one is not derivable from anything else the node carries,
+      so intel,inbound-shift and intel,outbound-shift come with it.
+
+  intel,inbound-shift:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Bit position in the byte-swap word of this root complex's inbound
+      (device to memory) swapper.
+    maximum: 31
+
+  intel,outbound-shift:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Bit position in the byte-swap word of this root complex's outbound
+      (CPU to device) swapper.
+    maximum: 31
+
+  intel,inbound-swap:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Whether the inbound swapper is enabled. This depends on the endpoint
+      behind the port rather than on the SoC, because an endpoint that already
+      presents host-endian shared memory must not be swapped a second time.
+      The swappers exist for a big-endian CPU and stay off on a little-endian
+      kernel whatever this says.
+    enum: [0, 1]
+    default: 0
+
+  intel,outbound-swap:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Whether the outbound swapper is enabled. See intel,inbound-swap.
+    enum: [0, 1]
+    default: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - phys
+  - phy-names
+  - bus-range
+  - reset-gpios
+  - "#interrupt-cells"
+  - interrupt-map
+  - interrupt-map-mask
+  - intel,syscon
+  - intel,inbound-shift
+  - intel,outbound-shift
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/intel,grx500-clk.h>
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/mips-gic.h>
+
+    pcie@18900000 {
+        compatible = "intel,xrx500-pcie";
+        device_type = "pci";
+        reg = <0x18900000 0x100000>,
+              <0xbb000000 0x800000>,
+              <0x18800000 0x100000>;
+        reg-names = "dbi", "config", "app";
+        #address-cells = <3>;
+        #size-cells = <2>;
+        bus-range = <0x00 0x07>;
+        ranges = <0x02000000 0 0xb8000000 0xb8000000 0 0x03000000>;
+        linux,pci-domain = <0>;
+        max-link-speed = <2>;
+
+        interrupt-parent = <&gic>;
+        interrupts = <GIC_SHARED 152 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "ir";
+        #interrupt-cells = <1>;
+        interrupt-map-mask = <0 0 0 0x7>;
+        interrupt-map = <0 0 0 1 &gic GIC_SHARED 136 IRQ_TYPE_LEVEL_HIGH>,
+                        <0 0 0 2 &gic GIC_SHARED 137 IRQ_TYPE_LEVEL_HIGH>,
+                        <0 0 0 3 &gic GIC_SHARED 138 IRQ_TYPE_LEVEL_HIGH>,
+                        <0 0 0 4 &gic GIC_SHARED 139 IRQ_TYPE_LEVEL_HIGH>;
+
+        clocks = <&cgu GCLK_PCIE0>;
+        phys = <&pcie_phy0>;
+        phy-names = "pcie";
+        reset-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
+
+        intel,syscon = <&chiptop 0x4c>;
+        intel,inbound-shift = <5>;
+        intel,outbound-shift = <4>;
+        intel,inbound-swap = <1>;
+        intel,outbound-swap = <0>;
+    };
