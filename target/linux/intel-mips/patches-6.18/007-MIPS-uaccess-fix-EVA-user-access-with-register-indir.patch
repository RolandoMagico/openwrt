From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Mon, 10 Aug 2026 09:00:25 +0000
Subject: MIPS: uaccess: fix EVA user access with register-indirect addressing

__get_data_asm() and __put_data_asm() pass the user pointer through the
"o" (offsettable memory operand) constraint and splice it into the
access instruction as "%3". With CONFIG_EVA the access instruction is
not a plain lw/sw: user_lw()/user_sw() expand to the EVA variants
(lwe/swe/lbe/lhe/...), whose hardware offset field is only 9 bits
signed. The "o" constraint lets the compiler materialize any 16-bit
displacement, so a sufficiently large structure offset produces e.g.
"lwe $2, 300($5)", which the assembler either rejects outright or
expands via an address-generation macro sequence - and in the latter
case the faulting instruction is no longer at the "1:" label the
exception table points at, breaking the uaccess fixup contract.

Force register-indirect addressing instead: pass the pointer through a
plain "r" constraint and hard-code the zero-offset "(%3)" form, which
every EVA access instruction encodes. Add a "memory" clobber to replace
the ordering information previously conveyed by the memory operand.

Found on an EVA kernel for a MIPS interAptiv SoC, where init took a
fault on its first EVA user access and the exception table did not
catch it.

Assisted-by: Claude:claude-fable-5
Signed-off-by: Grische <github@grische.xyz>

diff --git a/arch/mips/include/asm/uaccess.h b/arch/mips/include/asm/uaccess.h
index c0cede273c7c..4c19dd945f57 100644
--- a/arch/mips/include/asm/uaccess.h
+++ b/arch/mips/include/asm/uaccess.h
@@ -207,7 +207,7 @@ struct __large_struct { unsigned long buf[100]; };
 	long __gu_tmp;							\
 									\
 	__asm__ __volatile__(						\
-	"1:	"insn("%1", "%3")"				\n"	\
+	"1:	"insn("%1", "(%3)")"				\n"	\
 	"2:							\n"	\
 	"	.insn						\n"	\
 	"	.section .fixup,\"ax\"				\n"	\
@@ -219,7 +219,8 @@ struct __large_struct { unsigned long buf[100]; };
 	"	"__UA_ADDR "\t1b, 3b				\n"	\
 	"	.previous					\n"	\
 	: "=r" (__gu_err), "=r" (__gu_tmp)				\
-	: "0" (0), "o" (__m(addr)), "i" (-EFAULT));			\
+	: "0" (0), "r" (addr), "i" (-EFAULT)				\
+	: "memory");			\
 									\
 	(val) = (__typeof__(*(addr))) __gu_tmp;				\
 }
@@ -298,7 +299,7 @@ do {									\
 #define __put_data_asm(insn, ptr)					\
 {									\
 	__asm__ __volatile__(						\
-	"1:	"insn("%z2", "%3")"	# __put_data_asm	\n"	\
+	"1:	"insn("%z2", "(%3)")"	# __put_data_asm	\n"	\
 	"2:							\n"	\
 	"	.insn						\n"	\
 	"	.section	.fixup,\"ax\"			\n"	\
@@ -309,8 +310,9 @@ do {									\
 	"	" __UA_ADDR "	1b, 3b				\n"	\
 	"	.previous					\n"	\
 	: "=r" (__pu_err)						\
-	: "0" (0), "Jr" (__pu_val), "o" (__m(ptr)),			\
-	  "i" (-EFAULT));						\
+	: "0" (0), "Jr" (__pu_val), "r" (ptr),				\
+	  "i" (-EFAULT)							\
+	: "memory");						\
 }
 
 #define __put_data_asm_ll32(insn, ptr)					\
