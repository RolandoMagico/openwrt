+static const struct ltq_dma_soc_cfg *ltq_dma_soc_cfg_get(phys_addr_t base)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ltq_dma_soc_cfgs); i++)
+		if (ltq_dma_soc_cfgs[i].base == base)
+			return &ltq_dma_soc_cfgs[i];
+
+	return NULL;
+}
