+int ltq_dma_ctrl_id_by_phys(phys_addr_t base)
+{
+	const struct ltq_dma_soc_cfg *cfg = ltq_dma_soc_cfg_get(base);
+
+	return cfg ? (int)cfg->cid : -ENODEV;
+}
