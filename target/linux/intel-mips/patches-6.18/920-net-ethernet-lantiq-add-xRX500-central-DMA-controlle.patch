+static inline void ltq_dma_w32_mask(struct dma_ctrl *pctrl, u32 clr, u32 set,
+				    u32 offset)
+{
+	ltq_dma_w32(pctrl, (ltq_dma_r32(pctrl, offset) & ~clr) | set, offset);
+}
