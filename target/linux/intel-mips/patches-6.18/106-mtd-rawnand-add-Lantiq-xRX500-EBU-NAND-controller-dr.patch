From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Mon, 10 Aug 2026 09:09:43 +0000
Subject: mtd: rawnand: add Lantiq xRX500 EBU NAND controller driver

Add a driver for the legacy External Bus Unit (EBU) NAND interface
of the Lantiq / Intel xRX500 (GRX350 family) SoCs, as used e.g. by
the AVM FRITZ!Box 7560.

The driver is modeled on intel-nand-controller.c (the LGM HSNAND
driver, which shares the EBU register block) with the high-speed
NAND and DMA paths stripped: on xRX500 the EBU is a plain
programmed-I/O NAND interface. Command/address/data dispatch is
implemented through the modern exec_op API; CLE/ALE/CS are driven
through address bits 2/3/4 of the chip-select-decoded NAND data
window. The chip-select index and the data window base come from
the device tree (the FRITZ!Box 7560 wires the flash to CS1 at
physical 0x17c00000).

Verified on FRITZ!Box 7560 hardware together with the Macronix
on-die ECC support: identify, read, erase, program, readback.

Assisted-by: Claude:claude-fable-5
Signed-off-by: Grische <github@grische.xyz>

diff --git a/drivers/mtd/nand/raw/Kconfig b/drivers/mtd/nand/raw/Kconfig
index 7408f34f0c68..ad1fa7321060 100644
--- a/drivers/mtd/nand/raw/Kconfig
+++ b/drivers/mtd/nand/raw/Kconfig
@@ -395,6 +395,15 @@ config MTD_NAND_INTEL_LGM
 	  Enables support for NAND Flash chips on Intel's LGM SoC.
 	  NAND flash controller interfaced through the External Bus Unit.
 
+config MTD_NAND_LANTIQ_XRX500
+	bool "Lantiq xRX500 (GRX350) EBU NAND controller"
+	depends on MIPS && OF && HAS_IOMEM
+	help
+	  Enables support for NAND Flash chips on the Lantiq / Intel xRX500
+	  (GRX350) family of SoCs, attached to the External Bus Unit (EBU)
+	  in legacy NAND mode. Used by the AVM FRITZ!Box 7560 and similar
+	  Lantiq-based boards. Uses the modern exec_op NAND API.
+
 config MTD_NAND_ROCKCHIP
 	tristate "Rockchip NAND controller"
 	depends on ARCH_ROCKCHIP && HAS_IOMEM
